# Go test/coverage artifacts
*.out
coverage*.out
*_cov.out

# OS
.DS_Store

# Vendoring (not used)
vendor/

# IDE
.idea/
.vscode/

# =============================================================================
# SDK Examples (build artifacts)
# =============================================================================

# Compiled example binaries — each named after its containing directory.
# These are `go build` artifacts, never source. A glob covers every numbered
# example (01…11 today, and any added later) so a new example's binary is
# ignored without editing this list.
examples/[0-9][0-9]-*/[0-9][0-9]-*

# =============================================================================
# Cross-repo development workspace (never committed)
# =============================================================================
# go.work wires this module to a local checkout of github.com/v0lka/flowsh
# during a cross-repo development cycle; the module still pins the published
# flowsh commit in go.mod. Keep it untracked (see c0wrk ADR-031).
go.work
go.work.sum
